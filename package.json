{
  "name": "nrl-draft-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w @nrl/server\" \"npm run dev -w @nrl/web\"",
    "build": "npm run build -w @nrl/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "npm run migrate -w @nrl/db",
    "db:deploy": "npm run migrate:deploy -w @nrl/db",
    "db:generate": "npm run generate -w @nrl/db",
    "db:studio": "npm run studio -w @nrl/db",
    "nrl:import": "npm run import -w @nrl/nrl --",
    "postinstall": "npm run generate -w @nrl/db",
    "report:points": "tsx --env-file-if-exists=.env scripts/points-report.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "dotenv": "^18.0.5",
    "tsx": "^4.23.15"
  }
}
