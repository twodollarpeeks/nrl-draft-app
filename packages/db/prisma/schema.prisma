generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// NRL data. IDs for clubs, players and matches are nrl.com's own, so re-running
// an import is a pure upsert and players keep their identity across seasons.
// ---------------------------------------------------------------------------

model Club {
  id        Int    @id // nrl.com teamId
  key       String @unique // nrl.com theme key, e.g. "sea-eagles"
  nickName  String // "Sea Eagles"
  name      String? // "Manly Warringah Sea Eagles"

  homeMatches Match[]      @relation("HomeClub")
  awayMatches Match[]      @relation("AwayClub")
  appearances Appearance[]
  players     Player[]
}

model Player {
  id         Int      @id // nrl.com playerId
  firstName  String
  lastName   String
  clubId     Int? // club of their most recent appearance
  profileUrl String?
  headImage  String?
  // Positions this player can fill in fantasy (FB, WG, CE, FE, HB, HK, FRF,
  // 2RF, LK), derived from where they started recently. An admin override, if
  // set, replaces the derived list.
  positions         String[]
  positionsOverride String[]
  // When we last looked up their nrl.com profile for a position (fallback for
  // players who never start), so a missing profile isn't re-fetched every run.
  profileCheckedAt  DateTime?
  updatedAt         DateTime @updatedAt

  club        Club?            @relation(fields: [clubId], references: [id])
  appearances Appearance[]
  draftPicks  DraftPick[]
  queuedIn    DraftQueueItem[]
  rosterSpots RosterEntry[]

  @@index([lastName, firstName])
}

model Round {
  id      String @id @default(cuid())
  season  Int
  number  Int // nrl.com round number: 1-27 regular season, 28-31 finals
  title   String // "Round 5", "Finals Week 1", "Grand Final"
  slug    String // URL segment: "round-5", "finals-week-1", "grand-final"
  isFinals Boolean @default(false)
  byeClubKeys String[] // Club.key of each club with a bye this round
  lastImportedAt DateTime?

  matches Match[]

  @@unique([season, number])
}

model Match {
  id         String   @id // nrl.com matchId, e.g. "20261110510"
  roundId    String
  homeClubId Int
  awayClubId Int
  kickoffAt  DateTime // UTC; lineups lock per player at this time
  venue      String?
  url        String   @unique
  // nrl.com matchState: "Upcoming" | "Pre" | "FirstHalf" | "HalfTime" |
  // "SecondHalf" | "FullTime" | ... stored verbatim.
  state      String
  homeScore  Int?
  awayScore  Int?
  // When nrl.com last changed this match's data (its "updated" field). Stats
  // keep being corrected for days after full time; re-imports compare this.
  sourceUpdatedAt DateTime?
  lastFetchedAt   DateTime?

  round       Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  homeClub    Club         @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClub    Club         @relation("AwayClub", fields: [awayClubId], references: [id])
  appearances Appearance[]

  @@index([roundId])
  @@index([kickoffAt])
}

// One named player in one match: the team list before kickoff, and the stats
// after. A player named but not used (reserve, late withdrawal) has
// minutes = 0 after full time, which is what triggers fantasy emergencies.
model Appearance {
  matchId       String
  playerId      Int
  clubId        Int
  jersey        Int
  positionLabel String // verbatim, e.g. "Five-Eighth", "Interchange", "Reserve"
  isStarter     Boolean // jersey 1-13 in a named starting position

  // Stats, null until the match has stats. The six scoring stats get their own
  // columns; every stat nrl.com reports is kept in `stats` for future scoring.
  minutes    Int?
  runMetres  Int?
  tackles    Int?
  tries      Int?
  tryAssists Int?
  goals      Int?
  errors     Int?
  stats      Json?

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])
  club   Club   @relation(fields: [clubId], references: [id])

  @@id([matchId, playerId])
  @@index([playerId])
}

// Every distinct payload fetched from nrl.com, gzipped, so imports can be
// replayed or re-normalised without hitting the site again. Identical
// re-fetches are not stored twice.
model RawScrape {
  id          String   @id @default(cuid())
  url         String
  kind        String // "draw" | "match"
  contentHash String
  payloadGz   Bytes
  fetchedAt   DateTime @default(now())

  @@unique([url, contentHash])
  @@index([url, fetchedAt])
}

model ImportRun {
  id         String    @id @default(cuid())
  season     Int
  round      Int
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String // "running" | "ok" | "error"
  summary    Json?
  error      String?

  @@index([season, round, startedAt])
}

// ---------------------------------------------------------------------------
// Auth (Better Auth's tables; field names must match what it expects)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions        Session[]
  accounts        Account[]
  teams           Team[]
  leaguesRun      League[]   @relation("Commissioner")
  auditLogEntries AuditLog[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Leagues
// ---------------------------------------------------------------------------

model League {
  id             String   @id @default(cuid())
  name           String
  season         Int // NRL season the league plays, e.g. 2027
  commissionerId String
  // "private" (invite link only) now; "public" later.
  visibility     String   @default("private")
  inviteCode     String   @unique
  // "setup" -> "drafting" -> "inSeason" -> "complete"
  status         String   @default("setup")
  // LeagueSettings from @nrl/shared, validated with zod on every write.
  settings       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  commissioner User          @relation("Commissioner", fields: [commissionerId], references: [id])
  teams        Team[]
  auditLog     AuditLog[]
  draft        Draft?
  roster       RosterEntry[]
}

// A user's team in a league. Also the league membership: one team per user
// per league.
model Team {
  id        String   @id @default(cuid())
  leagueId  String
  ownerId   String
  name      String
  createdAt DateTime @default(now())

  league     League           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  owner      User             @relation(fields: [ownerId], references: [id])
  draftPicks DraftPick[]
  queue      DraftQueueItem[]
  roster     RosterEntry[]

  @@unique([leagueId, ownerId])
  @@unique([leagueId, name])
}

// Every commissioner action and notable league event. Feeds the activity
// feed later.
model AuditLog {
  id        String   @id @default(cuid())
  leagueId  String
  actorId   String?
  action    String // e.g. "league.create", "team.join", "settings.update"
  payload   Json?
  createdAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([leagueId, createdAt])
}

// ---------------------------------------------------------------------------
// Draft
// ---------------------------------------------------------------------------

// One draft per league. The server owns the clock: `deadline` is when the
// team on the clock gets autopicked. Every change bumps `version`, which is
// also how a change takes the row lock that serialises picks.
model Draft {
  id                String    @id @default(cuid())
  leagueId          String    @unique
  type              String    @default("snake")
  // "live" | "paused" | "complete"
  status            String
  pickSeconds       Int
  // Team ids in round-1 order; snake reverses it every other round.
  order             String[]
  totalPicks        Int
  // 1-based overall pick number now on the clock (totalPicks + 1 when done).
  currentPick       Int       @default(1)
  deadline          DateTime?
  // While paused: how long the team on the clock had left.
  pausedRemainingMs Int?
  // Teams that missed a pick and now pick automatically until they opt out.
  autopilotTeamIds  String[]
  version           Int       @default(0)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  league League           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  picks  DraftPick[]
  queue  DraftQueueItem[]

  @@index([status])
}

model DraftPick {
  id        String   @id @default(cuid())
  draftId   String
  pickNo    Int
  round     Int
  teamId    String
  playerId  Int
  // "manager" | "autopick" | "commissioner"
  madeBy    String
  userId    String?
  createdAt DateTime @default(now())

  draft  Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  // The database itself refuses a second pick in the same slot, or the same
  // player twice, whatever happens in application code.
  @@unique([draftId, pickNo])
  @@unique([draftId, playerId])
}

// Each manager's private pre-draft wishlist, in order.
model DraftQueueItem {
  draftId  String
  teamId   String
  playerId Int
  rank     Int

  draft  Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@id([draftId, teamId, playerId])
  @@index([draftId, teamId, rank])
}

// Who owns which player in a league. Drafting creates entries; waivers and
// trades will end one (releasedAt) and start another. A player can have only
// one current entry per league (partial unique index in the migration).
model RosterEntry {
  id          String    @id @default(cuid())
  leagueId    String
  teamId      String
  playerId    Int
  acquiredVia String // "draft" (later: "waiver", "trade", "freeAgent")
  acquiredAt  DateTime  @default(now())
  releasedAt  DateTime?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@index([teamId])
  @@index([leagueId, playerId])
}

// ---------------------------------------------------------------------------
// Site settings (edited by site admins), one JSON value per key.
// ---------------------------------------------------------------------------

model SiteSetting {
  key       String   @id // e.g. "config"
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String? // admin's email
}
