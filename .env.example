# Copy to .env (never commit .env).

# API server
PORT=3001
# Origins allowed to call the API, comma-separated
WEB_ORIGIN=http://localhost:5173

# Neon: pooled (host has -pooler) for the app, direct for migrations
DATABASE_URL=
DIRECT_URL=

# Auth (Better Auth + Google). Secret: any random string of 32+ characters.
BETTER_AUTH_SECRET=
# The web app's origin: the browser reaches /api/auth through it.
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Site admins (comma-separated Google emails)
ADMIN_EMAILS=
