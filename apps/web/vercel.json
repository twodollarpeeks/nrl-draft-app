{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @nrl/web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://nrl-draft-api.onrender.com/api/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://nrl-draft-api.onrender.com/socket.io/:path*" },
    { "source": "/health", "destination": "https://nrl-draft-api.onrender.com/health" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
